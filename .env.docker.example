# Base de données MySQL (service docker-compose)
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Variables pour le conteneur MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=
