# Base de données MySQL (Railway ou locale)
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Port d'écoute du serveur (Railway injecte PORT automatiquement)
PORT=3000

# OpenAI — optionnel, pour activer le chatbot IA générative
OPENAI_API_KEY=
